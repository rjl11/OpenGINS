# Writes OUT (a C file with app_fw_version[] and app_fw_date[], see
# app/fw_version.h) from git in SRC; rewrites it only when the text changes.
# Run by the fw_version target in firmware/CMakeLists.txt at every build.
execute_process(COMMAND git describe --always --dirty --abbrev=7
                WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE ver
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc1)
execute_process(COMMAND git log -1 --format=%cd --date=format:%Y-%m-%d
                WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE date
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc2)
# Both go into C string literals: a tag that git describe picks could hold a
# quote or backslash, so anything but plain tag characters is refused.
if(NOT rc1 EQUAL 0 OR NOT ver MATCHES "^[A-Za-z0-9._+-]+$" OR ver MATCHES "^.{65}")
    set(ver "unknown")
endif()
if(NOT rc2 EQUAL 0 OR NOT date MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
    set(date "")
endif()
set(text "/* Generated by tools/fw_version.cmake; do not edit. */\n#include \"fw_version.h\"\nconst char app_fw_version[] = \"${ver}\";\nconst char app_fw_date[] = \"${date}\";\n")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
